# ─── AI Detective — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to git — this file is safe to commit.

# SambaNova API (case/story generation — Qwen3-235B)
# Get yours at: https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# Groq API (runtime LLM — Llama 3.1)
# Get yours at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI (STT, TTS, Translation — Indian languages)
# Get yours at: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
